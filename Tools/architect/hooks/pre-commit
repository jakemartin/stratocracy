#!/bin/bash
#
# BASH, NOT `sh`, AND THE SHEBANG USED TO OVERSTATE. This script uses `read -r -d ''` to walk
# NUL-delimited paths, which is a bashism: under `dash` it fails with "read: Illegal option -d",
# the staged check degrades to nothing, and the commit proceeds. Measured by a reviewer gate.
# On this machine `/bin/sh` IS bash 5.2 (Git for Windows) so the old form happened to work, but
# a shebang is where a reader checks portability and that one promised POSIX it did not meet.
#
# Stratocracy pre-commit hook -- runs the banner sweep when, and only when, the record
# it polices is part of the commit.
#
# WHY A HOOK AT ALL. `11fd9ae` made the banner sweep a rule an agent had to remember.
# Five commits later the memory failed and `185e88f` shipped a banner contradicting its
# own file 425 lines down; the reviewer's gate caught it as `VERDICT: BLOCK`. The sweep
# became a command (`strat_banner_sweep.py`) so the check could be run; this makes it run
# without anyone choosing to.
#
# IT CHECKS THE STAGED BYTES, NOT THE WORKING TREE, and that distinction is the whole
# point of putting it here rather than in a wrapper script. `git commit` records the
# INDEX. A sweep of the working copy would pass a commit whose staged `state.md` is a
# different, contradictory document -- exactly the failure mode a partial `git add -p`
# produces. The staged blob is extracted with `git show :<path>` and swept in isolation.
#
# THE TREE-SIDE FIGURES ARE READ FROM THE WORKING TREE ON PURPOSE. `Saved/AutomationReport/
# index.json` and the `IMPLEMENT_SIMPLE_AUTOMATION_TEST` census are the TRUTH the document
# is checked against, and they are not part of any commit. A suite count is right or wrong
# against the tests that exist, not against whatever was staged alongside the prose.
#
# INSTALLED, NOT SYMLINKED, and never through `core.hooksPath`: this repository already
# carries four Git LFS hooks in `.git/hooks/`, and pointing `core.hooksPath` elsewhere
# would silently disable every one of them. See `install.sh` in this directory.
#
# TO BYPASS, deliberately: `git commit --no-verify`. That is a legitimate move -- a
# work-in-progress commit on a branch is not a lie -- and the failure message says so.
# A gate nobody can get past is a gate people delete.

set -u

# Declared before any trap references it: the citation block below runs BEFORE the sweep
# creates its temp file, and `set -u` turns a trap naming an unset variable into a hard
# error on every commit. Measured in a sandbox: "STAGED: unbound variable" on line 1.
STAGED=""

STATE_REL="Tools/architect/state.md"
SWEEP_REL="Tools/architect/strat_banner_sweep.py"

# Nothing to do unless the record itself is going in. Keeps every other commit free.
REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0
SWEEP="$REPO_ROOT/$SWEEP_REL"

# THE VENDORED-CITATION CHECK RUNS ON EVERY COMMIT, not only when state.md is staged --
# it is cheap, and CI alone means an author learns minutes later from a red tick instead
# of at the moment of commit. The unit list is DERIVED from the vendored directory rather
# than typed: the CI step's first version hardcoded an alternation, omitted `Replay` and
# `Scenario`, and printed `clean` over twelve live citations until a reviewer gate caught it.
#
# IT READS THE STAGED BLOBS, NOT THE WORKING TREE, for the same reason the sweep below does.
# The first version grepped the checkout, which is a different document from the commit: a
# partially-staged change could be refused for a citation it is not committing, or -- the
# direction that matters -- pass while the staged bytes carry one. This session lost a fix to
# exactly that worktree-versus-index confusion (a `git checkout --` during a hook test
# reverted a file to HEAD), so the inconsistency is not hypothetical.
UNITS=$(ls "$REPO_ROOT"/Source/StratRules/*.h 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.h$//' | paste -sd'|' -)
if [ -n "$UNITS" ]; then
    # A FAILURE TO SET UP THE CHECK IS NOT A CHECK THAT PASSED. These were `|| exit 0`,
    # which meant a broken TMPDIR skipped the entire citation scan and created the commit
    # with no output but mktemp's own stderr -- demonstrated by a reviewer gate, which
    # landed `Save.h:64` in HEAD that way. It is precisely the substitution this hook's own
    # commit message condemns ("an unread file is not a clean file"), one level up.
    HITS=$(mktemp) || { echo "COMMIT REFUSED: mktemp failed, so the citation check did not run."; exit 1; }
    FAILED=$(mktemp) || { rm -f "$HITS"; echo "COMMIT REFUSED: mktemp failed, so the citation check did not run."; exit 1; }
    trap 'rm -f "$STAGED" "$HITS" "$FAILED"' EXIT

    # -z / read -d '': a path with a space split under the old unquoted `for f in $(...)`,
    # `git show` failed on the fragment, and 2>/dev/null turned the failure into silence --
    # a commit carrying `Save.h:64` was ALLOWED with no output at all. Demonstrated in a
    # throwaway repo by the reviewer, not theorised. -z also removes the core.quotePath
    # hazard for non-ASCII paths.
    #
    # ACMR, not ACM: a file staged as a RENAME is reported `R` and the old filter dropped it
    # entirely. A rename plus a small edit -- exactly the shape a citation edit has -- landed
    # a citation in HEAD with the hook silent. (A rename with a large edit degrades to D+A
    # and was already caught, which is why this hole only opened for small edits.)
    git diff --cached -z --name-only --diff-filter=ACMR -- "$REPO_ROOT/Source/" |
    while IFS= read -r -d '' f; do
        case "$f" in
            Source/StratRules/*) continue ;;
            *.h|*.cpp|*.inl) ;;
            *) continue ;;
        esac
        # A FAILURE TO READ A BLOB IS NOT A CLEAN BLOB. The old form discarded git show's
        # stderr and read the empty result as "no citations", which is the vacuous pass the
        # CI step refuses at the list level and this loop was not refusing at the file level.
        if ! blob=$(git show ":$f" 2>/dev/null); then
            printf '%s\n' "$f" >> "$FAILED"
            continue
        fi
        printf '%s' "$blob" | grep -nE "($UNITS)\.(h|good\.cpp|buggy\.cpp):[0-9]" |
            sed "s|^|$f:|" >> "$HITS" || true
    done

    if [ -s "$FAILED" ]; then
        echo ""
        echo "COMMIT REFUSED: could not read these staged blobs, so they were NOT checked:"
        cat "$FAILED"
        echo "An unread file is not a clean file. Bypass with: git commit --no-verify"
        exit 1
    fi
    if [ -s "$HITS" ]; then
        echo ""
        cat "$HITS"
        echo ""
        echo "COMMIT REFUSED: line-number citations into vendored headers, in the STAGED bytes."
        echo "Cite the SYMBOL, not the line -- a re-vendor moves every vendored line at once."
        echo "Bypass deliberately with: git commit --no-verify"
        exit 1
    fi

    # THE TREE-WIDE NET, KEPT AS A WARNING RATHER THAN DROPPED. Moving to staged blobs was
    # right for "what am I committing", but it gave up something real: the old worktree scan
    # is what rescued `84eed05`, where a file's fix had been reverted to HEAD by a stray
    # `git checkout --` and so was not staged at all. A staged-only check cannot see that.
    # This warns and never refuses -- an unstaged citation elsewhere is not this commit's
    # fault, and CI still holds the blocking tree-wide line on push.
    STRAY=$(cd "$REPO_ROOT" && grep -rEn "($UNITS)\.(h|good\.cpp|buggy\.cpp):[0-9]" Source/ 2>/dev/null \
            | grep -v "^Source/StratRules/" || true)
    if [ -n "$STRAY" ]; then
        echo ""
        echo "banner sweep WARNING (not blocking this commit): vendored line citations exist in"
        echo "the working tree, outside what you staged:"
        printf '%s\n' "$STRAY"
        echo "CI will refuse these on push."
    fi
fi

# Everything below is the banner sweep, which is only owed when the record itself is
# going in. Keeps every other commit free of it.
#
# ACMR AND A PATHSPEC, for the reason spelled out at the citation loop above. 4bfe8b3 fixed
# `ACM` -> `ACMR` there and left this line untouched 50 lines below it, so a `state.md` staged
# as a RENAME was reported `R`, missed the filter, and skipped the entire banner sweep through
# a silent `exit 0` -- the same defect the same commit had just paid to find, surviving at its
# sibling site. Found 2026-08-20 while writing up that commit.
#
# The pathspec replaces `grep -qx` rather than being carried alongside it: git does the
# matching, so a path containing a space needs no -z/-d '' dance here, and the check cannot
# drift from the variable it is testing.
# THE RECORD LEAVING $STATE_REL IS THE EVENT THAT MAKES THIS HOOK INERT, and it has to be
# caught BEFORE the trigger below, because in that case the trigger does not fire -- which is
# the whole failure. `STATE_REL` is a TYPED path, so once the record lives somewhere else this
# hook looks for a file that is not there and passes every commit in silence, exactly the
# guard-goes-inert shape the citation loop was already fixed for twice.
#
# The test is deliberately about the PATH and not about renames: in HEAD, not in the index,
# for any reason -- renamed, moved, deleted -- is the same event and wants the same answer.
# Parsing `--name-status -z` rename records would be a second thing to get wrong.
#
# It fires only when a commit actually removes the record from its configured path, so an
# ordinary commit, a partially-staged state.md, and a repository that never had one are all
# untouched. There is no HEAD on the first commit, `cat-file` fails, and the check stays quiet.
if git cat-file -e "HEAD:$STATE_REL" 2>/dev/null && ! git cat-file -e ":$STATE_REL" 2>/dev/null
then
    echo "COMMIT REFUSED: $STATE_REL is in HEAD but not in this commit's index, so this commit"
    echo "moves or deletes the record. This hook would then keep looking for $STATE_REL, find"
    echo "nothing, and pass every future commit without sweeping anything. What is staged:"
    git diff --cached --name-status -- "$REPO_ROOT/$STATE_REL" | sed 's/^/    /'
    echo ""
    echo "  Point the hook at the new path and reinstall:"
    echo "    STATE_REL= in Tools/architect/hooks/pre-commit"
    echo "    sh Tools/architect/hooks/install.sh"
    echo "  Or --no-verify if the record is meant to be gone."
    exit 1
fi

# ALREADY INERT, rather than about to become so: the configured path is in neither HEAD nor
# the index. Reachable through --no-verify or a clone whose record was removed earlier. This
# warns and never blocks -- a repository that legitimately has no record must not be wedged --
# but it does not stay quiet, because a guard that has silently stopped running is the thing
# this whole block exists to prevent. One line, and only in that state.
if ! git cat-file -e "HEAD:$STATE_REL" 2>/dev/null && ! git cat-file -e ":$STATE_REL" 2>/dev/null
then
    echo "banner sweep WARNING: no $STATE_REL in HEAD or the index -- this hook is configured"
    echo "                      for a path that does not exist, so it is checking nothing."
fi

if [ -z "$(git diff --cached --name-only --diff-filter=ACMR -- "$REPO_ROOT/$STATE_REL")" ]; then
    exit 0
fi


if [ ! -f "$SWEEP" ]; then
    echo "banner sweep: $SWEEP_REL is missing -- skipping (nothing to run, and refusing"
    echo "              to fail a commit over a tool that is not there)"
    exit 0
fi

# Find an interpreter. `python` first because that is what this project's own recorded
# commands use; `py -3` last because it exists only on Windows.
PY=""
for candidate in python python3; do
    if command -v "$candidate" >/dev/null 2>&1; then PY="$candidate"; break; fi
done
if [ -z "$PY" ] && command -v py >/dev/null 2>&1; then PY="py -3"; fi
if [ -z "$PY" ]; then
    echo "banner sweep: no python interpreter found -- skipping rather than blocking a commit"
    exit 0
fi

# `|| exit 0` here, while the two mktemps at the citation loop above already refused -- the
# same defect at its sibling site for the third time in this file. A temp file we could not
# create is a sweep that did not run.
STAGED=$(mktemp) || { echo "COMMIT REFUSED: mktemp failed, so the banner sweep did not run."; exit 1; }
# NAMES ALL THREE, because a second `trap ... EXIT` REPLACES the handler rather than adding
# to it -- the earlier form dropped $HITS and $FAILED and leaked two files per record commit
# (measured). They are all in scope by here, and `STAGED=""` up top keeps the first trap safe.
trap 'rm -f "$STAGED" "$HITS" "$FAILED"' EXIT
# AN UNREAD RECORD IS NOT A CLEAN RECORD, which is 4bfe8b3's own title, and this line was
# still doing the opposite of it: `git show` failing printed "skipping" and returned 0, so the
# record went into HEAD unswept and the hook reported nothing wrong. Reaching here means the
# trigger above already saw the path staged, so a read failure is a real anomaly and not a
# routine absence -- there is no benign reading of it left to protect.
if ! git show ":$STATE_REL" > "$STAGED" 2>/dev/null; then
    echo "COMMIT REFUSED: could not read the staged $STATE_REL, so it was NOT swept."
    echo "The trigger above saw it staged, so this is an index anomaly rather than a"
    echo "missing file. Re-stage it and try again."
    exit 1
fi


OUTPUT=$($PY "$SWEEP" "$STAGED" 2>&1)
STATUS=$?

if [ $STATUS -eq 0 ]; then
    echo "banner sweep: clean (staged $STATE_REL)"
    exit 0
fi

echo ""
echo "$OUTPUT"
echo ""
echo "--------------------------------------------------------------------------"
echo "COMMIT REFUSED: the staged $STATE_REL contradicts itself or the tree."
echo ""
echo "This is the check that '11fd9ae' made a memory job and that 185e88f then got"
echo "wrong -- a banner claiming one thing while the same file claims another."
echo ""
echo "  See every claim and how the sweep classified it:"
echo "    $PY $SWEEP_REL --explain"
echo ""
echo "  Deliberate bypass (a WIP commit is not a lie):"
echo "    git commit --no-verify"
echo "--------------------------------------------------------------------------"
exit 1
