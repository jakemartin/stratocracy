# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Exported Cowork project-memory notes (Tools/context/).
#
# These are a one-way local mirror of the desktop app's own memory store -- course
# slide transcriptions, assignment status, working notes. They are reference material
# for a session working in this repo, NOT part of the game or of any deliverable, and
# the slide transcriptions are third-party course material besides. Ignored so a
# `git add -A` cannot sweep them into a commit, which is exactly how they first
# reached one.
/Tools/context/

# Build and headless-suite transcripts.
#
# The documented command templates (.claude/skills/strat-parallel/SKILL.md) redirect
# both streams to "$TOP/build.log" and "$TOP/suite.log" -- the root of whichever tree
# is being built. Untracked and unignored, they were one `git add -A` away from a
# commit on any pass that had run a build or a suite.
#
# Anchored, because that is exactly where the templates write. `$TOP` is
# `git rev-parse --show-toplevel`, which in a linked worktree is that worktree's own
# root -- and the anchor resolves against the directory holding this .gitignore, which
# is that same root. One rule covers the main tree and every worktree under
# E:\MultiAgent\Strat-wt\ alike.
/build.log
/suite.log
