#!/bin/bash
#
# BASH, NOT `sh`, AND THE SHEBANG USED TO OVERSTATE. This script uses `read -r -d ''` to walk
# NUL-delimited paths, which is a bashism: under `dash` it fails with "read: Illegal option -d",
# the staged check degrades to nothing, and the commit proceeds. Measured by a reviewer gate.
# On this machine `/bin/sh` IS bash 5.2 (Git for Windows) so the old form happened to work, but
# a shebang is where a reader checks portability and that one promised POSIX it did not meet.
#
# Stratocracy pre-commit hook -- runs the banner sweep when, and only when, the record
# it polices is part of the commit.
#
# WHY A HOOK AT ALL. `11fd9ae` made the banner sweep a rule an agent had to remember.
# Five commits later the memory failed and `185e88f` shipped a banner contradicting its
# own file 425 lines down; the reviewer's gate caught it as `VERDICT: BLOCK`. The sweep
# became a command (`strat_banner_sweep.py`) so the check could be run; this makes it run
# without anyone choosing to.
#
# IT CHECKS THE STAGED BYTES, NOT THE WORKING TREE, and that distinction is the whole
# point of putting it here rather than in a wrapper script. `git commit` records the
# INDEX. A sweep of the working copy would pass a commit whose staged `state.md` is a
# different, contradictory document -- exactly the failure mode a partial `git add -p`
# produces. The staged blob is extracted with `git show :<path>` and swept in isolation.
#
# THE TREE-SIDE FIGURES ARE READ FROM THE WORKING TREE ON PURPOSE. `Saved/AutomationReport/
# index.json` and the `IMPLEMENT_SIMPLE_AUTOMATION_TEST` census are the TRUTH the document
# is checked against, and they are not part of any commit. A suite count is right or wrong
# against the tests that exist, not against whatever was staged alongside the prose.
#
# INSTALLED, NOT SYMLINKED, and never through `core.hooksPath`: this repository already
# carries four Git LFS hooks in `.git/hooks/`, and pointing `core.hooksPath` elsewhere
# would silently disable every one of them. See `install.sh` in this directory.
#
# TO BYPASS, deliberately: `git commit --no-verify`. That is a legitimate move -- a
# work-in-progress commit on a branch is not a lie -- and the failure message says so.
# A gate nobody can get past is a gate people delete.

set -u

# Declared before any trap references it: the citation block below runs BEFORE the sweep
# creates its temp file, and `set -u` turns a trap naming an unset variable into a hard
# error on every commit. Measured in a sandbox: "STAGED: unbound variable" on line 1.
STAGED=""
STAGEDIR=""
# HITS AND FAILED ARE INITIALISED HERE FOR THE SAME REASON STAGED IS, AND OMITTING THEM WAS A
# REAL LEAK RATHER THAN A TIDINESS POINT. They are assigned inside `if [ -n "$UNITS" ]` below,
# so on a tree with no `Source/StratRules/*.h` they never get set -- and the EXIT trap names
# them. Under `set -u` the trap then aborts on `$HITS` PART-WAY THROUGH, before reaching
# `rm -rf "$STAGEDIR"`, so the sweep's temp directory leaked once per record commit while the
# hook still exited 0 and looked clean. Reproduced with a control 2026-08-20 in a throwaway
# repo:
#     UNITS empty      -> "line 1: HITS: unbound variable", TMPDIR left holding tmp.yzQq8BDLYa
#     UNITS non-empty  -> no message, TMPDIR empty
# This is the FOURTH time in this file that a fix has been applied at one site and missed its
# sibling; see the ACMR note and the mktemp note below. Caught by a reviewer gate, not here.
HITS=""
FAILED=""
# DOCDIR is initialised here for the same reason, before anything can name it in a trap. The
# doc-citation gate below runs on every commit, ahead of the sweep's temp directory.
DOCDIR=""

# THE RECORD IS A DIRECTORY, AND ITS FILE LIST IS DERIVED FROM THE INDEX, NOT TYPED HERE.
# `state.md` was split into `state/` by owning agent on 2026-08-20. The previous version of
# this hook carried `STATE_REL="Tools/architect/state.md"` -- a TYPED path, which the file's
# own comments already flagged as the thing that makes a guard go quiet. Left that way after
# the split it would have looked for a file that is not there and passed every record commit
# in silence. Only the DIRECTORY is named now; which files are in it is git's answer.
STATE_DIR_REL="Tools/architect/state"
SWEEP_REL="Tools/architect/strat_banner_sweep.py"

# Nothing to do unless the record itself is going in. Keeps every other commit free.
#
# THIS `|| exit 0` IS THE SHAPE THIS FILE CONDEMNS TWICE ELSEWHERE, and it is left deliberately.
# A reviewer gate flagged it as a candidate for the same "a failure to set up read as a check
# that passed" defect, then failed to construct a reachable case: a `pre-commit` hook runs only
# from a work tree, and `--show-toplevel` cannot fail there. **Recorded as unreachable-as-measured
# rather than safe** -- failing to construct the case is not proving there is none. If a route is
# ever found, this line wants the same `exit 1` the mktemp sites got.
REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0
SWEEP="$REPO_ROOT/$SWEEP_REL"
DOCGATE="$REPO_ROOT/Tools/architect/strat_doc_citation_gate.py"

# Find an interpreter ONCE, up here, because two checks now need it: the doc-citation gate
# that runs on every commit, and the banner sweep that runs only when the record is staged.
# It was found inside the sweep section until 2026-08-20; leaving it there would have meant a
# second copy, and a second copy is how the ACMR filter and the mktemp guards each ended up
# fixed at one site and broken at their sibling -- three times in this file.
#
# `python` first because that is what this project's own recorded commands use; `py -3` last
# because it exists only on Windows. A missing interpreter SKIPS rather than blocks: refusing
# every commit on a machine without python is not a trade a documentation check gets to make.
PY=""
for candidate in python python3; do
    if command -v "$candidate" >/dev/null 2>&1; then PY="$candidate"; break; fi
done
if [ -z "$PY" ] && command -v py >/dev/null 2>&1; then PY="py -3"; fi

# THE VENDORED-CITATION CHECK RUNS ON EVERY COMMIT, not only when state.md is staged --
# it is cheap, and CI alone means an author learns minutes later from a red tick instead
# of at the moment of commit. The unit list is DERIVED from the vendored directory rather
# than typed: the CI step's first version hardcoded an alternation, omitted `Replay` and
# `Scenario`, and printed `clean` over twelve live citations until a reviewer gate caught it.
#
# IT READS THE STAGED BLOBS, NOT THE WORKING TREE, for the same reason the sweep below does.
# The first version grepped the checkout, which is a different document from the commit: a
# partially-staged change could be refused for a citation it is not committing, or -- the
# direction that matters -- pass while the staged bytes carry one. This session lost a fix to
# exactly that worktree-versus-index confusion (a `git checkout --` during a hook test
# reverted a file to HEAD), so the inconsistency is not hypothetical.
UNITS=$(ls "$REPO_ROOT"/Source/StratRules/*.h 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.h$//' | paste -sd'|' -)
if [ -n "$UNITS" ]; then
    # A FAILURE TO SET UP THE CHECK IS NOT A CHECK THAT PASSED. These were `|| exit 0`,
    # which meant a broken TMPDIR skipped the entire citation scan and created the commit
    # with no output but mktemp's own stderr -- demonstrated by a reviewer gate, which
    # landed `Save.h:64` in HEAD that way. It is precisely the substitution this hook's own
    # commit message condemns ("an unread file is not a clean file"), one level up.
    HITS=$(mktemp) || { echo "COMMIT REFUSED: mktemp failed, so the citation check did not run."; exit 1; }
    FAILED=$(mktemp) || { rm -f "$HITS"; echo "COMMIT REFUSED: mktemp failed, so the citation check did not run."; exit 1; }
    trap 'rm -f "$STAGED" "$HITS" "$FAILED"; rm -rf "$DOCDIR"' EXIT

    # -z / read -d '': a path with a space split under the old unquoted `for f in $(...)`,
    # `git show` failed on the fragment, and 2>/dev/null turned the failure into silence --
    # a commit carrying `Save.h:64` was ALLOWED with no output at all. Demonstrated in a
    # throwaway repo by the reviewer, not theorised. -z also removes the core.quotePath
    # hazard for non-ASCII paths.
    #
    # ACMR, not ACM: a file staged as a RENAME is reported `R` and the old filter dropped it
    # entirely. A rename plus a small edit -- exactly the shape a citation edit has -- landed
    # a citation in HEAD with the hook silent. (A rename with a large edit degrades to D+A
    # and was already caught, which is why this hole only opened for small edits.)
    git diff --cached -z --name-only --diff-filter=ACMR -- "$REPO_ROOT/Source/" |
    while IFS= read -r -d '' f; do
        case "$f" in
            Source/StratRules/*) continue ;;
            *.h|*.cpp|*.inl) ;;
            *) continue ;;
        esac
        # A FAILURE TO READ A BLOB IS NOT A CLEAN BLOB. The old form discarded git show's
        # stderr and read the empty result as "no citations", which is the vacuous pass the
        # CI step refuses at the list level and this loop was not refusing at the file level.
        if ! blob=$(git show ":$f" 2>/dev/null); then
            printf '%s\n' "$f" >> "$FAILED"
            continue
        fi
        printf '%s' "$blob" | grep -nE "($UNITS)\.(h|good\.cpp|buggy\.cpp):[0-9]" |
            sed "s|^|$f:|" >> "$HITS" || true
    done

    if [ -s "$FAILED" ]; then
        echo ""
        echo "COMMIT REFUSED: could not read these staged blobs, so they were NOT checked:"
        cat "$FAILED"
        echo "An unread file is not a clean file. Bypass with: git commit --no-verify"
        exit 1
    fi
    if [ -s "$HITS" ]; then
        echo ""
        cat "$HITS"
        echo ""
        echo "COMMIT REFUSED: line-number citations into vendored headers, in the STAGED bytes."
        echo "Cite the SYMBOL, not the line -- a re-vendor moves every vendored line at once."
        echo "Bypass deliberately with: git commit --no-verify"
        exit 1
    fi

    # THE TREE-WIDE NET, KEPT AS A WARNING RATHER THAN DROPPED. Moving to staged blobs was
    # right for "what am I committing", but it gave up something real: the old worktree scan
    # is what rescued `84eed05`, where a file's fix had been reverted to HEAD by a stray
    # `git checkout --` and so was not staged at all. A staged-only check cannot see that.
    # This warns and never refuses -- an unstaged citation elsewhere is not this commit's
    # fault, and CI still holds the blocking tree-wide line on push.
    STRAY=$(cd "$REPO_ROOT" && grep -rEn "($UNITS)\.(h|good\.cpp|buggy\.cpp):[0-9]" Source/ 2>/dev/null \
            | grep -v "^Source/StratRules/" || true)
    if [ -n "$STRAY" ]; then
        echo ""
        echo "banner sweep WARNING (not blocking this commit): vendored line citations exist in"
        echo "the working tree, outside what you staged:"
        printf '%s\n' "$STRAY"
        echo "CI will refuse these on push."
    fi
fi


# ---------------------------------------------------------------------------------------
# THE DOC-SIDE CITATION GATE. The block above bans vendored line citations in `Source/`. It
# does not look anywhere else, and neither does the CI step -- so on 2026-08-20 a reviewer
# gate found `Ui.h:326` in a record entry, and sweeping with the guards' own pattern found six
# more live citations in documentation (five in `.agents/ue-project-context.md`, one in
# `Tools/architect/state/tests.md`). `Source/` was clean throughout. The guard worked exactly
# where it looked; the citations moved to where it did not.
#
# IT READS THE STAGED BLOBS, like everything else in this hook, because `git commit` records
# the index. The whole document set is materialised from the index into a temp tree -- not just
# the changed files -- so the gate sees the documents as the commit will leave them.
# `--vendored-dir` still points at the real checkout: the unit list is derived from vendored
# headers, which are not part of the commit being checked.
#
# A doc cannot be banned outright the way `Source/` is: this record's convention is that an old
# claim stays, so its honest accounts of removed citations necessarily write those citations
# down. The gate exempts a citation whose surrounding text is TALKING ABOUT a citation. Its
# `--self-test` proves it still refuses a live one, and carries a fixture for the hole that
# exemption leaves.
#
# THE ROOTS ARE ASKED FOR, NOT TYPED, AND THAT IS A 2026-08-26 REPAIR. This block used to carry
# its own copy of the gate's `DOC_ROOTS`, hand-filtered to `.md`. It was correct only for as
# long as the two lists happened to agree -- the same "guard types its own subject" defect this
# tooling keeps finding, moved one process boundary away, where neither side's self-test can
# see it. The gate's subject set was widened that day to cover `Tools/architect/*.py`, and this
# hook would have staged not one of them: the temp tree would still have held documents, the
# gate would still have derived its record subjects and exited 0, and every record line
# citation in the tooling would have sailed through the hook and failed in CI. `--print-scan-spec`
# is the gate answering for itself, one `EXT<TAB>PATH` line at a time.
if [ -n "$PY" ] && [ -f "$DOCGATE" ]; then
    # `tr -d '\r'` IS LOAD-BEARING ON THIS BOX, not defensive habit. A Windows Python prints
    # `\r\n`, so without it `DOC_ROOT` ends in a carriage return, every `git ls-files` pathspec
    # misses, `DOC_INDEX` comes back empty and the whole gate is skipped -- silently, at exit 0,
    # on the branch below that treats "nothing staged" as "nothing to check". Measured the day
    # this was written: the first build did exactly that, and only the widened gate's own
    # refusal to derive a subject set from a `.md`-less temp tree turned the silence into a
    # visible failure. That refusal is what caught it; do not remove either.
    DOC_SPEC=$("$PY" "$DOCGATE" --print-scan-spec 2>/dev/null | tr -d '\r' || true)
    if [ -z "$DOC_SPEC" ]; then
        echo "COMMIT REFUSED: the doc-citation gate could not name the roots it scans"
        echo "(--print-scan-spec produced nothing), so this hook cannot stage the right files"
        echo "for it. A check that did not run is not a check that passed."
        echo "Bypass deliberately with: git commit --no-verify"
        exit 1
    fi
    DOC_INDEX=""
    while IFS=$'\t' read -r DOC_EXT DOC_ROOT; do
        [ -n "$DOC_ROOT" ] || continue
        DOC_HITS=$(git ls-files --cached -- "$REPO_ROOT/$DOC_ROOT" \
                       | grep -E "\.$DOC_EXT\$" || true)
        [ -n "$DOC_HITS" ] || continue
        DOC_INDEX="$DOC_INDEX$DOC_HITS"$'\n'
    done <<< "$DOC_SPEC"
    DOC_INDEX=$(printf '%s' "$DOC_INDEX" | grep -v '^$' || true)
    if [ -n "$DOC_INDEX" ]; then
        DOCDIR=$(mktemp -d) || { echo "COMMIT REFUSED: mktemp -d failed, so the doc-citation gate did not run."; exit 1; }
        DOC_READ_FAILED=""
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            mkdir -p "$DOCDIR/$(dirname "$f")"
            if ! git show ":$f" > "$DOCDIR/$f" 2>/dev/null; then
                DOC_READ_FAILED="$DOC_READ_FAILED$f\n"
            fi
        done <<< "$DOC_INDEX"
        if [ -n "$DOC_READ_FAILED" ]; then
            echo "COMMIT REFUSED: could not read these staged documents, so they were NOT checked:"
            printf "$DOC_READ_FAILED"
            echo "An unread file is not a clean file."
            exit 1
        fi
        DOC_OUT=$($PY "$DOCGATE" --repo "$DOCDIR" --vendored-dir "$REPO_ROOT/Source/StratRules" 2>&1)
        DOC_STATUS=$?
        rm -rf "$DOCDIR"; DOCDIR=""
        if [ $DOC_STATUS -ne 0 ]; then
            echo ""
            echo "$DOC_OUT"
            echo ""
            echo "COMMIT REFUSED: the doc-citation gate refused this commit -- its own output is"
            echo "above and says why. The usual reason is a live line-number citation in the"
            echo "STAGED prose or tooling; a non-zero exit for any OTHER reason (the gate crashed,"
            echo "or found nothing to scan) is also a refusal, because a check that did not run is"
            echo "not a check that passed. The first version of this message asserted a citation"
            echo "unconditionally and said so during a crash that had found none."
            echo "For a VENDORED citation, cite the SYMBOL -- the enclosing function, struct or"
            echo "comment block -- because a re-vendor moves every vendored line at once and"
            echo "nothing reads one to notice. For a RECORD citation (\`global.md:412\` and the"
            echo "like), quote the SENTENCE or name the HEADING: that file grows above the line"
            echo "you named, so the number moves with the next entry."
            echo "If it is an account of a PAST citation, say so in words near it."
            echo "Bypass deliberately with: git commit --no-verify"
            exit 1
        fi
    fi
fi

# Everything below is the banner sweep, which is only owed when the record itself is
# going in. Keeps every other commit free of it.
#
# ACMR AND A PATHSPEC, for the reason spelled out at the citation loop above. 4bfe8b3 fixed
# `ACM` -> `ACMR` there and left the equivalent line down here untouched, so a record file staged
# as a RENAME was reported `R`, missed the filter, and skipped the entire banner sweep through a
# silent `exit 0` -- the same defect the same commit had just paid to find, surviving at its
# sibling site. Found 2026-08-20 while writing up that commit; the pathspec now covers a
# directory, so the same mistake is not available to make one file at a time.

# WHAT THE COMMIT WILL RECORD IS THE INDEX, so the file list comes from the index and not from
# the working tree. That is also why no HEAD-versus-staged merge is needed: `git ls-files
# --cached` already IS the post-commit tree for this directory -- a file added shows up, a file
# deleted does not, and a file left alone carries its HEAD bytes.
INDEX_FILES=$(git ls-files --cached -- "$REPO_ROOT/$STATE_DIR_REL" | grep -E '\.md$' || true)
HEAD_FILES=$(git ls-tree -r --name-only HEAD -- "$STATE_DIR_REL" 2>/dev/null | grep -E '\.md$' || true)

# THE RECORD LEAVING $STATE_DIR_REL IS THE EVENT THAT MAKES THIS HOOK INERT, and it has to be
# caught BEFORE the trigger below, because in that case the trigger does not fire -- which is
# the whole failure. The test is about the DIRECTORY being emptied of markdown, not about any
# one path: renamed, moved, deleted are the same event and want the same answer.
if [ -n "$HEAD_FILES" ] && [ -z "$INDEX_FILES" ]; then
    echo "COMMIT REFUSED: $STATE_DIR_REL holds the record in HEAD but this commit's index has no"
    echo ".md file there, so this commit moves or deletes the record. This hook would then keep"
    echo "looking in $STATE_DIR_REL, find nothing, and pass every future commit without sweeping"
    echo "anything. What is staged:"
    git diff --cached --name-status -- "$REPO_ROOT/$STATE_DIR_REL" | sed 's/^/    /'
    echo ""
    echo "  Point the hook at the new directory and reinstall:"
    echo "    STATE_DIR_REL= in Tools/architect/hooks/pre-commit"
    echo "    sh Tools/architect/hooks/install.sh"
    echo "  Or --no-verify if the record is meant to be gone."
    exit 1
fi

# ALREADY INERT, rather than about to become so. Reachable through --no-verify or a clone whose
# record was removed earlier. Warns and never blocks -- a repository that legitimately has no
# record must not be wedged -- but it does not stay quiet, because a guard that has silently
# stopped running is the thing this whole block exists to prevent.
if [ -z "$HEAD_FILES" ] && [ -z "$INDEX_FILES" ]; then
    echo "banner sweep WARNING: no .md file in $STATE_DIR_REL in HEAD or the index -- this hook"
    echo "                      is configured for a directory that holds no record, so it is"
    echo "                      checking nothing."
fi

if [ -z "$(git diff --cached --name-only --diff-filter=ACMR -- "$REPO_ROOT/$STATE_DIR_REL")" ]; then
    exit 0
fi

if [ -z "$PY" ]; then
    echo "banner sweep: no python interpreter found -- skipping rather than blocking a commit"
    exit 0
fi

if [ ! -f "$SWEEP" ]; then
    echo "banner sweep: $SWEEP_REL is missing -- skipping (nothing to run, and refusing"
    echo "              to fail a commit over a tool that is not there)"
    exit 0
fi

# `|| exit 1` here, while an earlier version of this file used `|| exit 0` at one of its three
# temp sites -- the same defect at a sibling site for the third time. A temp directory we could
# not create is a sweep that did not run, and that is a refusal.
STAGEDIR=$(mktemp -d) || { echo "COMMIT REFUSED: mktemp -d failed, so the banner sweep did not run."; exit 1; }
# NAMES ALL FOUR, because a second `trap ... EXIT` REPLACES the handler rather than adding to
# it -- an earlier form dropped $HITS and $FAILED and leaked two files per record commit
# (measured). The empty initialisers up top are what make this safe: $HITS and $FAILED are
# assigned only when $UNITS is non-empty, so "they are all in scope by here" -- which this
# comment asserted until 2026-08-20 -- was FALSE, and the trap aborted mid-list on a tree with
# no vendored headers. See the initialiser block for the measurement.
trap 'rm -f "$STAGED" "$HITS" "$FAILED"; rm -rf "$STAGEDIR" "$DOCDIR"' EXIT

# AN UNREAD RECORD IS NOT A CLEAN RECORD, which is 4bfe8b3's own title. A `git show` failure
# here is an index anomaly, not a routine absence -- the file list came from the index one
# moment ago -- so there is no benign reading of it left to protect. Extracting every file,
# not only the staged ones, is the point: the sweep compares claims ACROSS the set, so a
# `global.md` swept without the `tests.md` that contradicts it would print clean.
SWEEP_ARGS=()
while IFS= read -r f; do
    [ -n "$f" ] || continue
    # BASENAME IS SAFE ONLY WHILE THE RECORD DIRECTORY IS FLAT, and it is flat today. If
    # `state/` ever nests -- a `state/ui/global.md` alongside `state/global.md` -- two entries
    # would collapse onto one temp path and the second would silently overwrite the first,
    # sweeping a set that is missing a file while reporting the full count. Refuse instead of
    # discovering it later.
    #
    # THIS CANNOT FIRE ON A CONFLICTED RECORD MERGE, BUT NOT BECAUSE THIS LOOP IS CLEVER.
    # `git ls-files --cached` returns one entry PER STAGE while the index is unmerged, so a
    # conflicted `state/global.md` appears three times and would trip this check with a message
    # that misdescribes the situation entirely. It never gets here: the ACMR trigger above
    # returns empty on an unmerged index and the hook exits 0 first (measured on a re-gate;
    # `git commit` refuses earlier still). That protection is INCIDENTAL. If the trigger is ever
    # changed, teach this loop about merge stages in the same edit.
    dst="$STAGEDIR/$(basename "$f")"
    if [ -e "$dst" ]; then
        echo "COMMIT REFUSED: two record files share the basename $(basename "$f"), so the"
        echo "sweep would see only one of them. The sweep addresses files by basename; keep"
        echo "$STATE_DIR_REL flat, or teach both this hook and the sweep about subdirectories."
        exit 1
    fi
    if ! git show ":$f" > "$dst" 2>/dev/null; then
        echo "COMMIT REFUSED: could not read the staged $f, so the record was NOT swept."
        echo "The file list came from this commit's own index, so this is an index anomaly"
        echo "rather than a missing file. Re-stage and try again."
        exit 1
    fi
    SWEEP_ARGS+=("$dst")
done <<< "$INDEX_FILES"

if [ ${#SWEEP_ARGS[@]} -eq 0 ]; then
    echo "COMMIT REFUSED: the trigger fired but no record file was extracted, so nothing was"
    echo "swept. This is a bug in this hook, not a clean record."
    exit 1
fi

OUTPUT=$($PY "$SWEEP" "${SWEEP_ARGS[@]}" 2>&1)
STATUS=$?

if [ $STATUS -eq 0 ]; then
    echo "banner sweep: clean (${#SWEEP_ARGS[@]} staged file(s) under $STATE_DIR_REL)"
    exit 0
fi

echo ""
echo "$OUTPUT"
echo ""
echo "--------------------------------------------------------------------------"
echo "COMMIT REFUSED: the staged record under $STATE_DIR_REL contradicts itself or the tree."
echo ""
echo "This is the check that '11fd9ae' made a memory job and that 185e88f then got"
echo "wrong -- a banner claiming one thing while the record claims another. Since the"
echo "2026-08-20 split the two halves can be in DIFFERENT files, which is why every"
echo "file in the set is swept together rather than one at a time."
echo ""
echo "  See every claim and how the sweep classified it:"
echo "    $PY $SWEEP_REL --explain"
echo ""
echo "  Deliberate bypass (a WIP commit is not a lie):"
echo "    git commit --no-verify"
echo "--------------------------------------------------------------------------"
exit 1
